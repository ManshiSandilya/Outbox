# Google OAuth Client ID (shared with frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Server-only JWT Secret for httpOnly session cookies
JWT_SECRET=replace-with-a-long-random-secret

# Server & Frontend Origins
FRONTEND_ORIGIN=http://localhost:5173
PORT=3000

# PostgreSQL Database Connection String (Prisma ORM)
DATABASE_URL="postgresql://neondb_owner:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# Redis Configuration (BullMQ Queue & Hourly Rate Limit Counters)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Elasticsearch Service URL
ELASTICSEARCH_URL=http://127.0.0.1:9200

# SMTP Ethereal Email Configuration
SEED_SMTP_HOST=smtp.ethereal.email
SEED_SMTP_PORT=587
SEED_SMTP_USERNAME=your-ethereal-username
SEED_SMTP_PASSWORD_ENCRYPTED=your-ethereal-password
SEED_SENDER_EMAIL=your-ethereal-sender@ethereal.email

# Slack OAuth 2.0 Integration Configuration
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:3000/api/slack/callback
SLACK_OAUTH_STATE_SECRET=replace-with-slack-state-secret

# Hourly Rate Limiting (Emails per hour per sender)
MAX_EMAILS_PER_HOUR_PER_SENDER=100

