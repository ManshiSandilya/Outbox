# Google OAuth client ID, shared with the Vite public client ID below.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Required server-only secret for the signed httpOnly session cookie.
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-secret
# Optional; defaults to http://localhost:5173 for development.
FRONTEND_ORIGIN=http://localhost:5173
